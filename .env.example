# Global Factory Configuration
PORT=4000
NODE_ENV=development

# Core Semantic layer routing
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBE_TOKEN=your_secure_cube_jwt_token_here

# Infra Targets (Stubbed for Multi-Cloud Virtualization Engine)
AWS_POSTGRES_CRM_URL=postgresql://user:pass@aws-rds-endpoint:5432/crm_db
AZURE_SQL_LEDGER_URL=Server=tcp:azure-sql-endpoint.database.windows.net,1433;Database=ledger_db;